{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Webview gets fs access to $APPDATA only; user folders are added at runtime by Rust (native dialog / CLI). Godot paths live in a Rust-only file.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-stat",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [{"path": "$APPDATA/**"}],
      "deny": [{"path": "$APPCONFIG/godot-paths.json"}]
    }
  ]
}
