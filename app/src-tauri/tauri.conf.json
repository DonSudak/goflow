{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Go Flow — Useless Tycoon",
  "mainBinaryName": "goflow-ut",
  "version": "0.3.0",
  "identifier": "space.goflow.uselesstycoon",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev:local",
    "beforeBuildCommand": "npm run build:local-static"
  },
  "app": {
    "windows": [{"label": "main", "title": "Go Flow — Useless Tycoon", "width": 1440, "height": 900, "dragDropEnabled": false}],
    "security": {"csp": null}
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "Development",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
